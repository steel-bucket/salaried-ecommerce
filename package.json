{
  "name": "salaried-ecommerce",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server/server.js",
  "scripts": {
    "dev": "cross-env PAYLOAD_CONFIG_PATH=src/config/payload.config.ts nodemon",
    "generate:types": "cross-env PAYLOAD_CONFIG_PATH=src/config/payload.config.ts payload generate:types",
    "build:server": "tsc --project tsconfig.server.json",
    "build:next": "cross-env PAYLOAD_CONFIG_PATH=dist/config/payload.config.js NEXT_BUILD=true node dist/server/server.js",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png}\" dist/",
    "build": "cross-env NODE_ENV=production next build && yarn build:server && yarn copyfiles && yarn build:next",
    "start": "cross-env PAYLOAD_CONFIG_PATH=dist/config/payload.config.js NODE_ENV=production node dist/server/server.js",
    "lint": "next lint"
  },
  "dependencies": {
