{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "jsx": "react",
    "noImplicitAny": false,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/server/server.ts",
    "src/config/payload.config.ts",
    "src/server/**/*",
    "src/config/**/*",
    "src/lib/**/*"
  ]
}
